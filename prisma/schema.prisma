// Prisma schema — defines the database structure for the entertainment web app.
// Create and apply committed migrations with `npx prisma migrate dev`, then run `npx prisma generate`.

// Generator: produce the Prisma Client for Node.js
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions  Session[]
  bookmarks Bookmark[]
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model MediaReference {
  id                 String   @id @default(uuid())
  provider           String
  externalId         String
  mediaType          String
  titleSnapshot      String
  yearSnapshot       Int?
  posterPathSnapshot String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  bookmarks Bookmark[]

  @@unique([provider, externalId, mediaType])
  @@index([provider, externalId])
}

model Bookmark {
  id               String   @id @default(uuid())
  userId           String
  mediaReferenceId String
  createdAt        DateTime @default(now())

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaReference MediaReference @relation(fields: [mediaReferenceId], references: [id], onDelete: Cascade)

  @@unique([userId, mediaReferenceId])
  @@index([userId, createdAt])
}
