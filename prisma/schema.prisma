// Prisma schema — defines the database structure for the entertainment web app.
// Create and apply committed migrations with `npx prisma migrate dev`, then run `npx prisma generate`.

// Generator: produce the Prisma Client for Node.js
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions  Session[]
  bookmarks Bookmark[]
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model MediaReference {
  id                    String   @id @default(uuid())
  provider              String
  externalId            String
  mediaType             String
  titleSnapshot         String
  yearSnapshot          Int?
  posterPathSnapshot    String?
  backdropPathSnapshot  String?
  contentRatingSnapshot String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  bookmarks Bookmark[]

  @@unique([provider, externalId, mediaType])
  @@index([provider, externalId])
}

model Bookmark {
  id               String   @id @default(uuid())
  userId           String
  mediaReferenceId String
  createdAt        DateTime @default(now())

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaReference MediaReference @relation(fields: [mediaReferenceId], references: [id], onDelete: Cascade)

  @@unique([userId, mediaReferenceId])
  @@index([userId, createdAt])
}

// Fixed-window rate-limit counter. Exactly one current row per (scope, caller
// bucket): `windowStart`/`count`/`expiresAt` describe the active window and are
// replaced in place when the window rolls over, so no per-window history
// accumulates. `bucketKey` is a hash of the caller identifier so raw client IPs
// are never stored; `expiresAt` marks when the window resets and enables later
// cleanup of abandoned buckets.
model RateLimitCounter {
  scope       String
  bucketKey   String
  windowStart DateTime
  count       Int      @default(0)
  expiresAt   DateTime

  @@id([scope, bucketKey])
  @@index([expiresAt])
}
