# PostgreSQL connection string for the application database. Nuxt reads this
# value when the production server starts; do not set it only during the build.
NUXT_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# TMDB server-side token. Never expose this value to the browser or commit a real token.
NUXT_TMDB_ACCESS_TOKEN="replace-with-a-tmdb-api-read-access-token"

# Provisional locale and certification region defaults from TASK-BE-003.
NUXT_TMDB_LANGUAGE="en-US"
NUXT_TMDB_REGION="US"

# Non-secret tuning values. Cache TTL may be 0 to disable caching.
NUXT_TMDB_REQUEST_TIMEOUT_MS="5000"
NUXT_TMDB_CACHE_TTL_SECONDS="300"
NUXT_SESSION_TTL_SECONDS="604800"
NODE_ENV="development"

# Isolated PostgreSQL database used only by the integration test suite.
# The database name or host must contain "test" — the test setup refuses to
# run destructive cleanup against a connection string that does not.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/app_test"
