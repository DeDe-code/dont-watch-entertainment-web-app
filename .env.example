# Prisma CLI connection. Required for migration commands; keep it secret.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# Nuxt server runtime connection. Keep it secret and set it at runtime.
NUXT_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# Server-side TMDB API Read Access Token. Secret; never expose or commit it.
NUXT_TMDB_ACCESS_TOKEN="replace-with-a-tmdb-api-read-access-token"

# Non-secret TMDB and session settings.
NUXT_TMDB_LANGUAGE="en-US"
NUXT_TMDB_REGION="US"
NUXT_TMDB_REQUEST_TIMEOUT_MS="5000"
NUXT_TMDB_CACHE_TTL_SECONDS="300"
NUXT_SESSION_TTL_SECONDS="604800"
NODE_ENV="development"

# Isolated PostgreSQL database used only by integration tests. Secret.
# The host or database name must contain "test".
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/app_test"
